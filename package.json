    "format": "prettier --write --experimental-cli src/ tui/"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@prettier/plugin-oxc": "^0.0.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-oxlint": "~1.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-vue": "~10.5.1",
    "globals": "^16.5.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.29.0",
    "prettier": "3.6.2",
    "tsx": "^4.22.4",
    "vite": "^6.0.0",
    "vite-plugin-vue-devtools": "^8.0.5"
